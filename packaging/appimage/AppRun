#!/bin/sh
# AppImage entry point: let the program find the bundled SDL2 libraries and run it.
# The fonts are found by the program itself (usr/fonts, next to usr/bin).
HERE="$(dirname "$(readlink -f "$0")")"
export LD_LIBRARY_PATH="$HERE/usr/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
exec "$HERE/usr/bin/tiepaper" "$@"
